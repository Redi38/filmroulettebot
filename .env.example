# Telegram Bot Token (get in @BotFather)
TOKEN=your_bot_token_here

# TMDB API key
TMDB_API_KEY=your_tmdb_key_here

# History clear limit
HISTORY_CLEAR_LIMIT=10

# Database path
DB_PATH=bot_data.db

# Logging
LOG_LEVEL=INFO

# Watch link
WATCH_LINK_TEMPLATE=your_link_here

# Caddy proxy
TRUST_PROXY_HEADERS=False/True
